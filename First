    const gooseActor = document.getElementById('gooseActor');
    const gooseNameInput = document.getElementById('gooseNameInput');
    const speechBubble = document.getElementById('speechBubble');
    const speechText = document.getElementById('speechText');
    const honkBtn = document.getElementById('honkBtn');
    const soundToggleBtn = document.getElementById('soundToggleBtn');
    const soundIcon = document.getElementById('soundIcon');
    const itemsGrid = document.getElementById('itemsGrid');
    const categoryNav = document.getElementById('categoryNav');
    const clearCategoryBtn = document.getElementById('clearCategoryBtn');
    const currentlyWearingSummary = document.getElementById('currentlyWearingSummary');
    const activeOutfitCount = document.getElementById('activeOutfitCount');
    const randomizeBtn = document.getElementById('randomizeBtn');
    const resetBtn = document.getElementById('resetBtn');
    const snapshotBtn = document.getElementById('snapshotBtn');
    const backdropSelectors = document.getElementById('backdropSelectors');
    const blushCheek = document.getElementById('blushCheek');
    const baseFeetLayer = document.getElementById('baseFeetLayer');

    // Layer SVG slots
    const layerHat = document.getElementById('layerHat');
    const layerOutfit = document.getElementById('layerOutfit');
    const layerNeckwear = document.getElementById('layerNeckwear');
    const layerBeak = document.getElementById('layerBeak');
    const layerFootwear = document.getElementById('layerFootwear');
    const layerEyewear = document.getElementById('layerEyewear');

    // Photo Modal DOM
    const photoModal = document.getElementById('photoModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const downloadPhotoBtn = document.getElementById('downloadPhotoBtn');
    const snapshotCanvas = document.getElementById('snapshotCanvas');
    const polaroidTitle = document.getElementById('polaroidTitle');

    function renderCategoryTabs() {
      categoryNav.querySelectorAll('.cat-tab').forEach(btn => {
        const cat = btn.dataset.cat;
        if (cat === GooseState.activeCategory) {
          btn.className = 'cat-tab active px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap bg-amber-500 text-white shadow-xs';
        } else {
          btn.className = 'cat-tab px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap bg-slate-100 text-slate-600 hover:bg-slate-200';
        }
      });
    }

    function renderItemsGrid() {
      itemsGrid.innerHTML = '';
      const items = WARDROBE_DATA[GooseState.activeCategory] || [];
      const currentEquipped = GooseState.equipment[GooseState.activeCategory];

      items.forEach(item => {
        const isEquipped = (item.isBlushToggle) ? GooseState.blushCheeks : (currentEquipped === item.id);
        
        const card = document.createElement('div');
        card.className = `group relative rounded-2xl p-3 border-2 cursor-pointer transition-all duration-200 flex flex-col items-center justify-between text-center ${
          isEquipped 
            ? 'border-amber-500 bg-amber-50 shadow-md ring-2 ring-amber-400/30' 
            : 'border-slate-200/80 bg-white hover:border-amber-300 hover:shadow-sm'
        }`;

        card.innerHTML = `
          <!-- Thumbnail icon badge -->
          <div class="w-16 h-16 rounded-xl flex items-center justify-center p-1.5 mb-2 relative overflow-hidden transition-transform group-hover:scale-105" style="background-color: ${item.previewBg}">
            <svg viewBox="0 0 500 620" class="w-24 h-24 overflow-visible">
              ${item.svg}
            </svg>
          </div>
          
          <div class="w-full">
            <h4 class="text-xs font-bold text-slate-800 line-clamp-1 leading-tight">${item.name}</h4>
            <span class="text-[10px] font-semibold text-amber-700/80">${item.tag}</span>
          </div>

          <!-- Equiped Indicator Checkmark -->
          ${isEquipped ? `
            <div class="absolute -top-1.5 -right-1.5 w-6 h-6 rounded-full bg-amber-500 text-white flex items-center justify-center text-xs shadow-md border-2 border-white">
              <i class="fa-solid fa-check"></i>
            </div>
          ` : ''}
        `;

        card.addEventListener('click', () => {
          toggleEquipItem(GooseState.activeCategory, item);
        });

        itemsGrid.appendChild(card);
      });

      updateWearSummary();
    }

    function updateWearSummary() {
      let count = 0;
      const equippedNames = [];

      Object.entries(GooseState.equipment).forEach(([cat, id]) => {
        if (id) {
          count++;
          const found = WARDROBE_DATA[cat]?.find(i => i.id === id);
          if (found) equippedNames.push(found.name);
        }
      });

      activeOutfitCount.textContent = `${count} Worn`;
      if (count === 0) {
        currentlyWearingSummary.textContent = "Wearing: Natural Goose";
      } else {
        currentlyWearingSummary.textContent = `Wearing: ${equippedNames.slice(0, 2).join(', ')}${equippedNames.length > 2 ? ` +${equippedNames.length - 2} more` : ''}`;
      }
    }

    function toggleEquipItem(category, item) {
      soundSystem.playClick();

      if (item.isBlushToggle) {
        GooseState.blushCheeks = !GooseState.blushCheeks;
        blushCheek.style.display = GooseState.blushCheeks ? 'block' : 'none';
        renderItemsGrid();
        return;
      }

      // If already equipped, unequip; otherwise equip
      if (GooseState.equipment[category] === item.id) {
        GooseState.equipment[category] = null;
      } else {
        GooseState.equipment[category] = item.id;
      }

      renderGooseLayers();
      renderItemsGrid();
    }

    function renderGooseLayers() {
      // 1. Hat layer
      const hatItem = WARDROBE_DATA.hats.find(i => i.id === GooseState.equipment.hats);
      layerHat.innerHTML = hatItem ? hatItem.svg : '';

      // 2. Outfit layer
      const outfitItem = WARDROBE_DATA.outfits.find(i => i.id === GooseState.equipment.outfits);
      layerOutfit.innerHTML = outfitItem ? outfitItem.svg : '';

      // 3. Neckwear layer
      const neckItem = WARDROBE_DATA.neckwear.find(i => i.id === GooseState.equipment.neckwear);
      layerNeckwear.innerHTML = neckItem ? neckItem.svg : '';

      // 4. Beak layer
      const beakItem = WARDROBE_DATA.beak.find(i => i.id === GooseState.equipment.beak);
      layerBeak.innerHTML = beakItem ? beakItem.svg : '';

      // 5. Footwear layer (hides base feet when boots are worn for neat styling)
      const footItem = WARDROBE_DATA.footwear.find(i => i.id === GooseState.equipment.footwear);
      if (footItem) {
        layerFootwear.innerHTML = footItem.svg;
        baseFeetLayer.style.display = 'none';
      } else {
        layerFootwear.innerHTML = '';
        baseFeetLayer.style.display = 'block';
      }

      // 6. Eyewear / Extra layer
      const extraItem = WARDROBE_DATA.extra.find(i => i.id === GooseState.equipment.extra && !i.isBlushToggle);
      layerEyewear.innerHTML = extraItem ? extraItem.svg : '';
    }

    function initBackdrops() {
      backdropSelectors.innerHTML = '';
      BACKDROPS.forEach(bd => {
        const btn = document.createElement('button');
        const isActive = GooseState.backdrop === bd.id;
        btn.className = `px-3 py-1 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${
          isActive 
            ? 'bg-amber-100 text-amber-900 border border-amber-300' 
            : 'text-slate-600 hover:bg-slate-100'
        }`;
        btn.innerHTML = `<i class="fa-solid ${bd.icon}"></i> <span>${bd.name}</span>`;
        btn.addEventListener('click', () => {
          setBackdrop(bd.id);
        });
        backdropSelectors.appendChild(btn);
      });

      applyBackdrop(GooseState.backdrop);
    }

    function setBackdrop(id) {
      soundSystem.playClick();
      GooseState.backdrop = id;
      initBackdrops();
    }

    function applyBackdrop(id) {
      const bd = BACKDROPS.find(b => b.id === id) || BACKDROPS[0];
      sceneContainer.className = `relative w-full aspect-[4/5] max-h-[580px] rounded-3xl overflow-hidden shadow-2xl border-4 border-white transition-all duration-500 bg-gradient-to-b ${bd.bgClass} flex flex-col justify-end items-center`;
      envBackdrop.innerHTML = bd.decorSvg;
    }

    let honkTimeout = null;
    function triggerHonk() {
      soundSystem.playHonk();

      // Trigger visual bounce animation
      gooseActor.classList.remove('idle-breathe');
      gooseActor.classList.remove('honking-animation');
      void gooseActor.offsetWidth; // re-flow
      gooseActor.classList.add('honking-animation');

      // Random Honk quote
      const randMsg = HONK_MESSAGES[Math.floor(Math.random() * HONK_MESSAGES.length)];
      speechText.textContent = randMsg;

      speechBubble.classList.remove('opacity-0', 'pointer-events-none');
      speechBubble.classList.add('bubble-pop');

      clearTimeout(honkTimeout);
      honkTimeout = setTimeout(() => {
        speechBubble.classList.remove('bubble-pop');
        speechBubble.classList.add('opacity-0', 'pointer-events-none');
        gooseActor.classList.add('idle-breathe');
      }, 1500);
    }

    // Category tabs click
    categoryNav.addEventListener('click', (e) => {
      const tabBtn = e.target.closest('.cat-tab');
      if (tabBtn) {
        soundSystem.playClick();
        GooseState.activeCategory = tabBtn.dataset.cat;
        renderCategoryTabs();
        renderItemsGrid();
      }
    });

    // Clear currently selected category
    clearCategoryBtn.addEventListener('click', () => {
      soundSystem.playClick();
      GooseState.equipment[GooseState.activeCategory] = null;
      renderGooseLayers();
      renderItemsGrid();
    });

    // Goose Actor Click -> Honk!
    gooseActor.addEventListener('click', triggerHonk);
    honkBtn.addEventListener('click', triggerHonk);

    // Sound Mute Toggle
    soundToggleBtn.addEventListener('click', () => {
      soundSystem.enabled = !soundSystem.enabled;
      if (soundSystem.enabled) {
        soundIcon.className = "fa-solid fa-volume-high";
        soundToggleBtn.classList.remove('text-slate-400');
        soundToggleBtn.classList.add('text-slate-600');
      } else {
        soundIcon.className = "fa-solid fa-volume-xmark";
        soundToggleBtn.classList.add('text-slate-400');
        soundToggleBtn.classList.remove('text-slate-600');
      }
      soundSystem.playClick();
    });

    // Randomize Outfit ("Surprise me!")
    randomizeBtn.addEventListener('click', () => {
      soundSystem.playClick();

      // Random hat (50% chance)
      GooseState.equipment.hats = Math.random() > 0.35 
        ? WARDROBE_DATA.hats[Math.floor(Math.random() * WARDROBE_DATA.hats.length)].id 
        : null;

      // Random outfit (60% chance)
      GooseState.equipment.outfits = Math.random() > 0.3 
        ? WARDROBE_DATA.outfits[Math.floor(Math.random() * WARDROBE_DATA.outfits.length)].id 
        : null;

      // Random neckwear (40% chance)
      GooseState.equipment.neckwear = Math.random() > 0.5 
        ? WARDROBE_DATA.neckwear[Math.floor(Math.random() * WARDROBE_DATA.neckwear.length)].id 
        : null;

      // Random beak item (40% chance)
      GooseState.equipment.beak = Math.random() > 0.5 
        ? WARDROBE_DATA.beak[Math.floor(Math.random() * WARDROBE_DATA.beak.length)].id 
        : null;

      // Random footwear (40% chance)
      GooseState.equipment.footwear = Math.random() > 0.5 
        ? WARDROBE_DATA.footwear[Math.floor(Math.random() * WARDROBE_DATA.footwear.length)].id 
        : null;

      // Random extra (30% chance)
      GooseState.equipment.extra = Math.random() > 0.6 
        ? WARDROBE_DATA.extra.filter(e => !e.isBlushToggle)[Math.floor(Math.random() * 2)].id 
        : null;

      // Random backdrop
      const randomBackdrop = BACKDROPS[Math.floor(Math.random() * BACKDROPS.length)].id;
      setBackdrop(randomBackdrop);

      renderGooseLayers();
      renderItemsGrid();
      triggerHonk();
    });

    // Naked Goose / Reset All
    resetBtn.addEventListener('click', () => {
      soundSystem.playClick();
      Object.keys(GooseState.equipment).forEach(k => GooseState.equipment[k] = null);
      renderGooseLayers();
      renderItemsGrid();
    });

    // Goose Name update
    gooseNameInput.addEventListener('input', (e) => {
      GooseState.name = e.target.value.trim() || 'Desk Goose';
      polaroidTitle.textContent = GooseState.name;
    });

    snapshotBtn.addEventListener('click', () => {
      soundSystem.playClick();
      generatePolaroidSnapshot();
      photoModal.classList.remove('hidden');
    });

    closeModalBtn.addEventListener('click', () => {
      photoModal.classList.add('hidden');
    });

    photoModal.addEventListener('click', (e) => {
      if (e.target === photoModal) photoModal.classList.add('hidden');
    });

    function generatePolaroidSnapshot() {
      polaroidTitle.textContent = GooseState.name || 'Lucy the Goose';
      
      const width = 600;
      const height = 750;
      snapshotCanvas.width = width;
      snapshotCanvas.height = height;
      const ctx = snapshotCanvas.getContext('2d');

      // 1. Draw Backdrop gradient
      const grad = ctx.createLinearGradient(0, 0, 0, height);
      if (GooseState.backdrop === 'rainy') {
        grad.addColorStop(0, '#94a3b8');
        grad.addColorStop(1, '#a5f3fc');
      } else if (GooseState.backdrop === 'autumn') {
        grad.addColorStop(0, '#fed7aa');
        grad.addColorStop(1, '#e7e5e4');
      } else if (GooseState.backdrop === 'porch') {
        grad.addColorStop(0, '#bae6fd');
        grad.addColorStop(1, '#d1fae5');
      } else {
        // desk default
        grad.addColorStop(0, '#fef3c7');
        grad.addColorStop(1, '#fed7aa');
      }
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      // Floor plank
      ctx.fillStyle = '#78350f';
      ctx.fillRect(0, height - 130, width, 130);
      ctx.fillStyle = '#451a03';
      ctx.fillRect(0, height - 130, width, 10);

      // 2. Convert SVG into canvas image
      const svgElement = document.getElementById('gooseSvg');
      const xml = new XMLSerializer().serializeToString(svgElement);
      const svg64 = btoa(unescape(encodeURIComponent(xml)));
      const b64Start = 'data:image/svg+xml;base64,';
      const image64 = b64Start + svg64;

      const img = new Image();
      img.onload = function() {
        // Draw centered goose
        const gooseW = 460;
        const gooseH = 570;
        const x = (width - gooseW) / 2;
        const y = height - gooseH - 45;
        ctx.drawImage(img, x, y, gooseW, gooseH);

        // Stamp date watermark
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
        ctx.font = 'bold 16px Nunito, sans-serif';
        const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        ctx.fillText(`Honk Studio • ${today}`, 24, 38);
      };
      img.src = image64;
    }

    // Save/Download Polaroid
    downloadPhotoBtn.addEventListener('click', () => {
      soundSystem.playClick();
      const link = document.createElement('a');
      link.download = `${GooseState.name.toLowerCase().replace(/\s+/g, '-')}-snapshot.png`;
      link.href = snapshotCanvas.toDataURL('image/png');
      link.click();
    });

    window.addEventListener('DOMContentLoaded', () => {
      initBackdrops();
      renderCategoryTabs();
      renderItemsGrid();
      renderGooseLayers();
    });
  </script>

</body>
</html>
